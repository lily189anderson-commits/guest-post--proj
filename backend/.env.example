# Copy this file to `.env` and fill in real values.

# PostgreSQL (recommended for production):
DATABASE_URL=postgresql+psycopg2://gp_user:gp_password@localhost:5432/guest_post_engine

# MySQL alternative:
# DATABASE_URL=mysql+pymysql://gp_user:gp_password@localhost:3306/guest_post_engine

# If DATABASE_URL is left unset, the app falls back to a local SQLite file
# (sqlite:///./guest_post_engine.db) so you can run it without installing a DB server.

SECRET_KEY=replace-with-a-long-random-secret-key
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480

CORS_ORIGINS=*

DEFAULT_ADMIN_USERNAME=admin
DEFAULT_ADMIN_PASSWORD=admin123
